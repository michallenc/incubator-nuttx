if ARCH_CHIP_PIC32C

comment "PIC32C Configuration Options"

# Chip Selection

choice
	prompt "Microchip PIC32C Chip Selection"
	default ARCH_CHIP_SAMV71Q21

config ARCH_CHIP_PIC32C
	bool "SAME70Q19"
	select ARCH_CHIP_SAME70Q
	select SAMV7_MEM_FLASH_512
	select SAMV7_MEM_RAM_256

endchoice #
